<resources>
    <style name="Theme.AppRehabilitacion" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash screen (androidx.core:core-splashscreen): se ve mientras la
         app arranca; postSplashScreenTheme es al que se pasa apenas termina. -->
    <style name="Theme.AppRehabilitacion.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/verde_primario</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_sanna_logo_completo</item>
        <item name="postSplashScreenTheme">@style/Theme.AppRehabilitacion</item>
    </style>
</resources>
