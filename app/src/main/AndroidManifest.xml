<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- RNF06 / CA03: solo los permisos estrictamente necesarios -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- required="false" (RNF03-CA03): el dispositivo sin camara debe poder
         instalar la app y recibir un mensaje explicito de incompatibilidad,
         no quedar filtrado silenciosamente por Google Play. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".RehabApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.AppRehabilitacion"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AppRehabilitacion.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
