rules_version = '2';

// Storage guarda el material terapéutico (video/imagen de ejercicios) y,
// desde 2026-09-18, el video de cada sesión del paciente para que su
// fisioterapeuta lo revise y pueda dar una mejor respuesta. El análisis con MediaPipe
// sigue siendo local (Edge AI); el paciente lo acepta en el consentimiento.
service firebase.storage {
  match /b/{bucket}/o {

    function estaAutenticado() {
      return request.auth != null;
    }

    // material de apoyo de un ejercicio (HU02, HU05). El control de acceso
    // por rol ("solo fisioterapeuta puede crear/editar") ya lo hace
    // Firestore en ejercicios/{id} (allow create, update: if esFisioterapeuta());
    // aquí solo se exige autenticación. Se descartó comprobar el rol vía
    // referencia cruzada a Firestore (firestore.get(...)) porque esa sintaxis
    // no es válida en este motor de Storage Rules — provocaba que la función
    // fallara siempre y bloqueara el write con 403 para cualquiera.
    match /ejercicios/{ejercicioId}/{archivo} {
      allow read: if estaAutenticado();
      allow write: if estaAutenticado();
    }

    // Parte 3 (video de la sesión): el paciente sube el video de SU sesión
    // (solo en su propia carpeta, solo video, tope de 200 MB); lo lee
    // cualquier usuario autenticado que tenga la URL (con token de descarga)
    // -- Storage no puede cruzar a Firestore para comprobar "es su
    // fisioterapeuta" (ver nota de ejercicios arriba).
    match /sesiones/{pacienteId}/{archivo} {
      allow read: if estaAutenticado();
      allow write: if estaAutenticado() &&
                      request.auth.uid == pacienteId &&
                      request.resource.size < 200 * 1024 * 1024 &&
                      request.resource.contentType.matches('video/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
