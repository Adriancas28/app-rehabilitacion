rules_version = '2';

// RNF02 — Seguridad de acceso a la información terapéutica.
// Modelo de datos: DICCIONARIO_DE_DATOS_FIRESTORE (docs/modelo-datos).
// Roles: "paciente" | "fisioterapeuta" | "administrador", definidos en usuarios/{uid}.rol
// pacientes/{uid} y fisioterapeutas/{uid} comparten el id de usuarios/{uid} (herencia).
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function esDueno(uid) {
      return estaAutenticado() && request.auth.uid == uid;
    }

    function rolDe(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data.rol;
    }

    function esFisioterapeuta() {
      return estaAutenticado() && rolDe(request.auth.uid) == 'fisioterapeuta';
    }

    // HU20/HU21 — el administrador gestiona cuentas de pacientes y
    // fisioterapeutas.
    function esAdmin() {
      return estaAutenticado() && rolDe(request.auth.uid) == 'administrador';
    }

    // HU22-CA01: el paciente debe poder ver a su propio fisioterapeuta
    // asignado (nombre y datos) en su Perfil.
    function esPacienteDe(fisioUid) {
      return estaAutenticado() &&
             get(/databases/$(database)/documents/pacientes/$(request.auth.uid)).data.fisioterapeutaId == fisioUid;
    }

    // usuarios/{uid} — cuenta: correo, rol, nombre, fechaCreacion, activo
    match /usuarios/{uid} {
      allow read: if esDueno(uid) || esFisioterapeuta() || esAdmin() || esPacienteDe(uid);
      allow create, delete: if esDueno(uid) || esAdmin();
      allow update: if esDueno(uid) || esAdmin();
    }

    // pacientes/{uid} — dni, edad, genero, contacto, ladoAfectado, fisioterapeutaId
    match /pacientes/{uid} {
      allow read: if esDueno(uid) || esFisioterapeuta() || esAdmin();
      allow create, update, delete: if esAdmin();

      // pacientes/{uid}/diagnosticos/{id} — diagnosticoId, fecha
      // HU01-CA06: el fisioterapeuta registra los diagnósticos.
      match /diagnosticos/{diagnosticoDoc} {
        allow read: if esDueno(uid) || esFisioterapeuta() || esAdmin();
        allow write: if esFisioterapeuta() || esAdmin();
      }
    }

    // Lectura agregada de diagnósticos (collection group) para las listas de
    // pacientes del fisioterapeuta y del administrador.
    match /{path=**}/diagnosticos/{diagnosticoDoc} {
      allow read: if esFisioterapeuta() || esAdmin();
    }

    // fisioterapeutas/{uid} — edad, genero, contacto, especialidad, numeroColegiatura
    match /fisioterapeutas/{uid} {
      allow read: if esDueno(uid) || esFisioterapeuta() || esAdmin() || esPacienteDe(uid);
      allow create, update, delete: if esAdmin();
    }

    // catalogo_diagnosticos/{id} — nombre, regionCorporal (solo lectura)
    match /catalogo_diagnosticos/{id} {
      allow read: if estaAutenticado();
      allow write: if false;
    }

    // ejercicios/{ejercicioId} — catálogo, gestionado por fisioterapeutas
    match /ejercicios/{ejercicioId} {
      allow read: if estaAutenticado();
      allow create, update, delete: if esFisioterapeuta();
    }

    // sesiones/{sesionId} — colección de nivel superior (pacienteId,
    // fisioterapeutaId). Las consultas siempre filtran por uno de los dos
    // (o son del administrador), lo que permite a Firestore probar la regla.
    match /sesiones/{sesionId} {
      allow get, list: if esAdmin() ||
                          (estaAutenticado() &&
                           (resource.data.pacienteId == request.auth.uid ||
                            resource.data.fisioterapeutaId == request.auth.uid));
      allow create: if esFisioterapeuta() && request.resource.data.fisioterapeutaId == request.auth.uid;
      // El paciente guarda el resultado y el video; el fisioterapeuta edita la asignación.
      allow update: if estaAutenticado() &&
                       (resource.data.pacienteId == request.auth.uid ||
                        resource.data.fisioterapeutaId == request.auth.uid);
      allow delete: if false;

      // sesiones/{sesionId}/observaciones/{id} — recomendaciones del fisioterapeuta
      match /observaciones/{observacionId} {
        allow read: if estaAutenticado() &&
                       (get(/databases/$(database)/documents/sesiones/$(sesionId)).data.pacienteId == request.auth.uid ||
                        get(/databases/$(database)/documents/sesiones/$(sesionId)).data.fisioterapeutaId == request.auth.uid);
        allow create: if esFisioterapeuta() && request.resource.data.fisioterapeutaId == request.auth.uid;
        allow update, delete: if estaAutenticado() && resource.data.fisioterapeutaId == request.auth.uid;
      }
    }
  }
}
