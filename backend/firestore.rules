rules_version = '2';

// RNF02 — Seguridad de acceso a la información terapéutica.
// Roles: "paciente" | "fisioterapeuta" | "admin", definidos en usuarios/{uid}.rol
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function esDueno(uid) {
      return estaAutenticado() && request.auth.uid == uid;
    }

    function rolDe(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data.rol;
    }

    function esFisioterapeuta() {
      return estaAutenticado() && rolDe(request.auth.uid) == 'fisioterapeuta';
    }

    // HU20/HU21 — el administrador gestiona cuentas de pacientes y
    // fisioterapeutas (crear/editar/eliminar su documento en Firestore,
    // asignar fisioterapeutaId).
    function esAdmin() {
      return estaAutenticado() && rolDe(request.auth.uid) == 'admin';
    }

    // usuarios/{uid}
    match /usuarios/{uid} {
      allow read: if esDueno(uid) || esFisioterapeuta() || esAdmin();
      allow create, delete: if esDueno(uid) || esAdmin();
      // HU01-CA06: el fisioterapeuta asignado puede actualizar el
      // documento de su paciente (en la práctica, solo el diagnóstico —
      // el resto de campos del paciente los gestiona el admin, HU20).
      allow update: if esDueno(uid) || esAdmin() ||
                       (esFisioterapeuta() && resource.data.fisioterapeutaId == request.auth.uid);

      // usuarios/{pacienteId}/sesiones/{sesionId}
      match /sesiones/{sesionId} {
        allow read: if esDueno(uid) ||
                       (estaAutenticado() && resource.data.fisioterapeutaId == request.auth.uid);
        allow create: if esFisioterapeuta() && request.resource.data.fisioterapeutaId == request.auth.uid;
        allow update: if esDueno(uid) ||
                         (estaAutenticado() && resource.data.fisioterapeutaId == request.auth.uid);
        allow delete: if false;

        // usuarios/{pacienteId}/sesiones/{sesionId}/recomendaciones/{recomendacionId}
        match /recomendaciones/{recomendacionId} {
          allow read: if esDueno(uid) ||
                         (estaAutenticado() && resource.data.fisioterapeutaId == request.auth.uid);
          allow create: if esFisioterapeuta() && request.resource.data.fisioterapeutaId == request.auth.uid;
          allow update, delete: if estaAutenticado() && resource.data.fisioterapeutaId == request.auth.uid;
        }
      }
    }

    // ejercicios/{ejercicioId} — catálogo, gestionado por fisioterapeutas
    match /ejercicios/{ejercicioId} {
      allow read: if estaAutenticado();
      allow create, update, delete: if esFisioterapeuta();
    }
  }
}
